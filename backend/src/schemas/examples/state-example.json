            { "fieldName": "owner", "fieldType": "String" },
            { "fieldName": "balance", "fieldType": "u64" },
            { "fieldName": "permissions", "fieldType": "Vec<String>" },
            { "fieldName": "metadata", "fieldType": "Metadata" },
            { "fieldName": "security", "fieldType": "Security" }
          ]
        },
        {
          "name": "Escrow",
          "fields": [
            { "fieldName": "publicKey", "fieldType": "String" },
            { "fieldName": "privateKey", "fieldType": "String" },
