    "instructions": [
      {
        "name": "Create Vault",
        "description": "Initializes a new vault with a set deadline and fee structure.",
        "parameters": [
          {
            "paramName": "deadline",
            "type": "string",
            "defaultValue": "2024-09-01T00:00:00Z",
            "validationRules": {
              "required": true,
              "minLength": 20,
              "maxLength": 30,
              "minValue": null,
              "maxValue": null
            }
          },
          {
            "paramName": "fee",
            "type": "number",
            "defaultValue": 500,
            "validationRules": {
              "required": true,
              "minLength": null,
              "maxLength": null,
              "minValue": 0,
              "maxValue": 10000
            }
          }
        ],
        "expectedOutput": "Vault is created with the specified parameters.",
        "errorHandling": {
          "errorCode": "VAULT_CREATION_FAILED",
          "errorMessage": "Failed to create the vault due to insufficient permissions or invalid parameters."
        },
